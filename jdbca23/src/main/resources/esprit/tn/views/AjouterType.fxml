<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="esprit.tn.controllers.AjouterTypeController"
      spacing="10" padding="10">

    <Label text="Ajouter un Type" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <GridPane hgap="10" vgap="10">
        <Label text="Mode:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="modeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Ajouter" onAction="#handleAjouter"/>
        <Button text="Annuler" onAction="#handleAnnuler"/>
    </HBox>

</VBox>