<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.Controllers.Mayssa.CourseRegistrationController"
      spacing="10" alignment="CENTER" style="-fx-padding: 20;">

    <Label text="Course Registration" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <Label fx:id="courseTitleLabel" style="-fx-font-size: 16;"/>
    <Label fx:id="userInfoLabel"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Confirm Registration" onAction="#confirmRegistration" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Cancel" onAction="#cancelRegistration" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>
</VBox>