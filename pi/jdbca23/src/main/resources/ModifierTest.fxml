<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="esprit.tn.main.ModifierTestController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="Modifier un test" style="-fx-font-size: 20px;"/>
    
    <GridPane alignment="CENTER" hgap="10" vgap="10">
        <Label text="Heure du Test:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="heureDuTestField" promptText="Entrez l'heure du test" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <Label text="Matière:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="nomMatiereField" promptText="Entrez le nom de la matière" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>
    
    <Button text="Modifier" onAction="#handleModifier"/>
</VBox> 