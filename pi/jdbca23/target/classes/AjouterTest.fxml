<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" prefWidth="400" prefHeight="400" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="esprit.tn.main.AjouterTestController" stylesheets="@styles.css">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Ajouter un Test" style="-fx-font-size: 20; -fx-font-weight: bold"/>

    <GridPane alignment="CENTER" hgap="10" vgap="10">
        <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="idField" promptText="ID du test" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Heure du Test:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="heureDuTestField" promptText="Entrez l'heure du test" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Matière:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="nomMatiereField" promptText="Entrez le nom de la matière" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Ajouter" onAction="#handleAjouter" styleClass="button-primary"/>
        <Button text="Annuler" onAction="#handleAnnuler" styleClass="button-secondary"/>
    </HBox>
</VBox> 