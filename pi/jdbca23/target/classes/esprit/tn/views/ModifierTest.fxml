<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="esprit.tn.main.ModifierTestController"
      stylesheets="@../styles.css">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <GridPane hgap="10" vgap="10">
        <Label text="Heure du test:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="heureComboBox" promptText="Sélectionner l'heure" 
                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Nom matière:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="matiereTextField" promptText="Nom de la matière" 
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Formateur:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="formateurTextField" promptText="Nom du formateur" 
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Nom salle:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="salleTextField" promptText="Numéro de salle" 
                  GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Coefficient:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="coefficientTextField" promptText="Coefficient" 
                  GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Modifier" onAction="#handleModifier" styleClass="button-primary"/>
        <Button text="Annuler" onAction="#handleAnnuler" styleClass="button-secondary"/>
    </HBox>

</VBox>
